---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
  badge?: {
    text: string;
    theme?: "emerald" | "amber" | "indigo" | "rose";
  };
}

const { title, description, breadcrumbs = [], badge } = Astro.props;

const badgeClasses = {
  emerald: "bg-emerald-100 text-emerald-800 border-emerald-300",
  amber: "bg-amber-100 text-amber-800 border-amber-300",
  indigo: "bg-brand-indigo/15 text-brand-indigo border-brand-indigo/30",
  rose: "bg-rose-100 text-rose-800 border-rose-300",
}[badge?.theme || "emerald"];
---

<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
  <div>
    {breadcrumbs.length > 0 && (
      <nav class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 mb-2">
        <a href="/dashboard" class="hover:text-emerald-700 transition-colors">Dashboard</a>
        {breadcrumbs.map((crumb) => (
          <>
            <span class="text-slate-400">/</span>
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-emerald-700 transition-colors">
                {crumb.label}
              </a>
            ) : (
              <span class="text-slate-700">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>
    )}

    <div class="flex items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        {title}
      </h1>
      {badge && (
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border ${badgeClasses}`}>
          {badge.text}
        </span>
      )}
    </div>

    {description && (
      <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-3xl">
        {description}
      </p>
    )}
  </div>

  <div class="flex items-center gap-2.5 shrink-0">
    <slot name="actions" />
  </div>
</div>
