---
// LessonPlanModal.astro
---

<div id="lesson-plan-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div id="lesson-plan-modal-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity"></div>

  <div class="min-h-full flex items-center justify-center p-4">
    <div class="relative bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-7 shadow-2xl border border-slate-200 z-10 max-h-[92vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
        <div>
          <h3 id="lesson-plan-modal-title" class="text-base font-bold text-slate-900 flex items-center gap-2">
            <span>📝 Tambah Modul RPP 5-Pilar</span>
          </h3>
          <p class="text-xs text-slate-500 mt-0.5">
            Susun panduan ajar modul pembelajaran terstruktur berbasis metode: Lihat, Dengar, Lakukan, Catat, dan Repetisi.
          </p>
        </div>
        <button id="btn-close-lp-modal" type="button" class="p-1.5 text-slate-400 hover:text-slate-700 cursor-pointer text-sm">✕</button>
      </div>

      <!-- Alert -->
      <div id="lp-modal-alert" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

      <!-- Form -->
      <form id="form-lesson-plan" class="space-y-4">
        <input type="hidden" name="curriculumId" id="lp-curriculum-id" value="" />
        <input type="hidden" name="id" id="lp-id" value="" />

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Nomor Modul <span class="text-rose-500">*</span>
            </label>
            <input 
              type="number" 
              name="moduleNumber" 
              id="lp-module-number" 
              required 
              min="1" 
              value="1" 
              class="form-input text-xs py-2!" 
            />
          </div>
          <div class="sm:col-span-3">
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Judul Topik Modul <span class="text-rose-500">*</span>
            </label>
            <input 
              type="text" 
              name="topicTitle" 
              id="lp-topic-title" 
              required 
              placeholder="Contoh: Modul 1: Konsep Bilangan & Manik Bilangan (1 - 20)" 
              class="form-input text-xs py-2!" 
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Tujuan Pembelajaran (Satu per baris)
            </label>
            <textarea 
              name="learningObjectives" 
              id="lp-learning-objectives" 
              rows="3" 
              placeholder="Siswa mampu mengenali kuantitas 1-10&#10;Siswa memahami konsep pola urutan manik" 
              class="form-input text-xs py-2!"
            ></textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Alat Peraga & Bahan Manipulatif (Satu per baris)
            </label>
            <textarea 
              name="materialsNeeded" 
              id="lp-materials-needed" 
              rows="3" 
              placeholder="Set Manik Mahir 20 Buah&#10;Tali Perangkai&#10;Kartu Angka" 
              class="form-input text-xs py-2!"
            ></textarea>
          </div>
        </div>

        <!-- 5-Pillar Methodology Breakdown Section -->
        <div class="p-3.5 bg-slate-50/80 rounded-xl border border-slate-200 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-800 flex items-center gap-1.5">
              <span>⭐ Panduan Langkah Metodologi 5-Pilar</span>
            </span>
            <span class="text-[10px] text-slate-500 font-medium">Standar kurikulum nasional Mahir Edu</span>
          </div>

          <!-- 1. LIHAT -->
          <div class="p-2.5 bg-white rounded-xl border border-slate-200">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-bold text-sky-800 flex items-center gap-1.5">
                <span>👁️ 1. Pilar LIHAT (Visualisasi Konkrit)</span>
              </span>
              <div class="flex items-center gap-1 text-[11px] text-slate-500">
                <span>Durasi:</span>
                <input type="number" id="step-lihat-dur" value="10" min="1" class="w-14 form-input text-xs py-0.5! px-1.5! text-center font-bold" />
                <span>menit</span>
              </div>
            </div>
            <input type="text" id="step-lihat-title" placeholder="Judul langkah visual, e.g. Observasi Manik Warna" class="form-input text-xs py-1.5! mb-1.5" />
            <textarea id="step-lihat-inst" rows="2" placeholder="Instruksi kegiatan guru dan respon visual siswa..." class="form-input text-xs py-1.5!"></textarea>
          </div>

          <!-- 2. DENGAR -->
          <div class="p-2.5 bg-white rounded-xl border border-slate-200">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-bold text-amber-800 flex items-center gap-1.5">
                <span>👂 2. Pilar DENGAR (Auditori & Irama)</span>
              </span>
              <div class="flex items-center gap-1 text-[11px] text-slate-500">
                <span>Durasi:</span>
                <input type="number" id="step-dengar-dur" value="10" min="1" class="w-14 form-input text-xs py-0.5! px-1.5! text-center font-bold" />
                <span>menit</span>
              </div>
            </div>
            <input type="text" id="step-dengar-title" placeholder="Judul langkah auditori, e.g. Nyanyian Hitung Maju" class="form-input text-xs py-1.5! mb-1.5" />
            <textarea id="step-dengar-inst" rows="2" placeholder="Instruksi kegiatan suara, narasi cerita kontekstual, atau ketukan ritme..." class="form-input text-xs py-1.5!"></textarea>
          </div>

          <!-- 3. LAKUKAN -->
          <div class="p-2.5 bg-white rounded-xl border border-slate-200">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-bold text-emerald-800 flex items-center gap-1.5">
                <span>🤲 3. Pilar LAKUKAN (Kinestetik & Manipulatif)</span>
              </span>
              <div class="flex items-center gap-1 text-[11px] text-slate-500">
                <span>Durasi:</span>
                <input type="number" id="step-lakukan-dur" value="20" min="1" class="w-14 form-input text-xs py-0.5! px-1.5! text-center font-bold" />
                <span>menit</span>
              </div>
            </div>
            <input type="text" id="step-lakukan-title" placeholder="Judul aktivitas kinestetik, e.g. Praktik Merangkai Manik Fisik" class="form-input text-xs py-1.5! mb-1.5" />
            <textarea id="step-lakukan-inst" rows="2" placeholder="Instruksi eksplorasi tangan langsung menggunakan alat peraga manipulatif..." class="form-input text-xs py-1.5!"></textarea>
          </div>

          <!-- 4. CATAT -->
          <div class="p-2.5 bg-white rounded-xl border border-slate-200">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-bold text-purple-800 flex items-center gap-1.5">
                <span>📝 4. Pilar CATAT (Dokumentasi & Notasi)</span>
              </span>
              <div class="flex items-center gap-1 text-[11px] text-slate-500">
                <span>Durasi:</span>
                <input type="number" id="step-catat-dur" value="15" min="1" class="w-14 form-input text-xs py-0.5! px-1.5! text-center font-bold" />
                <span>menit</span>
              </div>
            </div>
            <input type="text" id="step-catat-title" placeholder="Judul langkah pencatatan, e.g. Lembar Notasi Lambang Bilangan" class="form-input text-xs py-1.5! mb-1.5" />
            <textarea id="step-catat-inst" rows="2" placeholder="Instruksi penulisan representasi simbolik pada buku kerja / lembar kerja..." class="form-input text-xs py-1.5!"></textarea>
          </div>

          <!-- 5. REPETISI -->
          <div class="p-2.5 bg-white rounded-xl border border-slate-200">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-bold text-rose-800 flex items-center gap-1.5">
                <span>🔁 5. Pilar REPETISI BERMAKNA (Penguatan Konsep)</span>
              </span>
              <div class="flex items-center gap-1 text-[11px] text-slate-500">
                <span>Durasi:</span>
                <input type="number" id="step-repetisi-dur" value="15" min="1" class="w-14 form-input text-xs py-0.5! px-1.5! text-center font-bold" />
                <span>menit</span>
              </div>
            </div>
            <input type="text" id="step-repetisi-title" placeholder="Judul kuis / permainan penguatan, e.g. Tebak Angka Cepat" class="form-input text-xs py-1.5! mb-1.5" />
            <textarea id="step-repetisi-inst" rows="2" placeholder="Instruksi games, refleksi, atau tantangan cepat untuk mengunci pemahaman..." class="form-input text-xs py-1.5!"></textarea>
          </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
          <button type="button" id="btn-cancel-lp" class="px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 cursor-pointer">
            Batal
          </button>
          <button type="submit" id="btn-submit-lp" class="btn-primary text-xs py-2! px-5! font-bold cursor-pointer inline-flex items-center gap-1.5">
            <svg id="btn-lp-spinner" class="hidden animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="btn-lp-text">Simpan Modul RPP</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
