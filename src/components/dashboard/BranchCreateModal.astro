---
// BranchCreateModal.astro
---

<div id="branch-create-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div id="branch-modal-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity"></div>

  <div class="min-h-full flex items-center justify-center p-4">
    <div class="relative bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 z-10">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>🏫 Daftarkan Sekolah Pemancar Baru</span>
          </h3>
          <p class="text-xs text-slate-500 mt-0.5">
            Daftarkan unit cabang kemitraan Mahir Edu dan terbitkan paket lisensi operasional perdana.
          </p>
        </div>
        <button id="btn-close-branch-modal" type="button" class="p-2 text-slate-400 hover:text-slate-700 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Alert -->
      <div id="branch-create-alert" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

      <!-- Form -->
      <form id="branch-create-form" class="space-y-4">
        <!-- 1. School Basic Info -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-700">1. Identitas Unit Sekolah:</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Nama Sekolah / Unit <span class="text-rose-500">*</span></label>
              <input type="text" name="name" id="b-name" required placeholder="Contoh: Sekolah Pemancar Mahir Solo" class="form-input text-xs py-2!" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Kode Cabang <span class="text-rose-500">*</span></label>
              <input type="text" name="code" id="b-code" required placeholder="Contoh: MHR-SLO-01" class="form-input text-xs py-2! uppercase font-mono" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-slate-600 mb-1">Alamat Jalan</label>
              <input type="text" name="street" id="b-street" placeholder="Jl. Slamet Riyadi No. 12" class="form-input text-xs py-1.5!" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Kota / Kabupaten</label>
              <input type="text" name="city" id="b-city" placeholder="Surakarta" class="form-input text-xs py-1.5!" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Kepala Sekolah</label>
              <input type="text" name="headmasterName" id="b-headmaster" placeholder="Drs. Hartono, M.Pd." class="form-input text-xs py-1.5!" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Email Sekolah</label>
              <input type="email" name="email" id="b-email" placeholder="solo@mahir-edu.com" class="form-input text-xs py-1.5!" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">No. WhatsApp / Telepon</label>
              <input type="text" name="phone" id="b-phone" placeholder="081234567890" class="form-input text-xs py-1.5!" />
            </div>
          </div>
        </div>

        <!-- 2. Initial License & Quota Configuration -->
        <div class="p-4 rounded-xl bg-purple-50/50 border border-purple-200 space-y-3">
          <div class="text-[11px] font-bold uppercase tracking-wider text-purple-900">2. Penerbitan Paket Lisensi Perdana:</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Paket Lisensi <span class="text-rose-500">*</span></label>
              <select name="packageType" id="b-package" class="form-input text-xs py-2!" required>
                <option value="standard">Paket Standard</option>
                <option value="basic">Paket Basic</option>
                <option value="premium">Paket Premium (Multisensory Kit)</option>
                <option value="enterprise">Paket Enterprise (Full Access)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Batas Kuota Guru</label>
              <input type="number" name="maxTeachers" id="b-max-teachers" value="15" min="1" class="form-input text-xs py-2!" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Batas Kuota Siswa</label>
              <input type="number" name="maxStudents" id="b-max-students" value="150" min="1" class="form-input text-xs py-2!" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Jatuh Tempo Pembayaran <span class="text-rose-500">*</span></label>
              <input type="date" name="dueDate" id="b-due-date" required class="form-input text-xs py-2!" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Masa Kedaluwarsa Lisensi <span class="text-rose-500">*</span></label>
              <input type="date" name="expiryDate" id="b-expiry-date" required class="form-input text-xs py-2!" />
            </div>
          </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
          <button type="button" id="btn-cancel-branch" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 cursor-pointer">
            Batal
          </button>
          <button type="submit" id="btn-submit-branch" class="btn-primary text-xs py-2! px-5! font-bold cursor-pointer inline-flex items-center gap-2">
            <svg id="btn-submit-branch-spinner" class="hidden animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="btn-submit-branch-text">Terbitkan Unit & Lisensi</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

