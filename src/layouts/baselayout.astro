---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Mahir School Management System",
  description = "Solusi Cerdas Manajemen Sekolah & Pembelajaran Multisensori Terpadu Mahir"
} = Astro.props;

let user = null;
try {
  if (Astro.cookies.has("__session")) {
    const auth = getAuth(app);
    const sessionCookie = Astro.cookies.get("__session")!.value;
    const decodedCookie = await auth.verifySessionCookie(sessionCookie);
    if (decodedCookie) {
      user = await auth.getUser(decodedCookie.uid);
    }
  }
} catch (e) {
  // Session cookie invalid or expired
  user = null;
}

const pathname = Astro.url.pathname;
const isNavActive = (path: string) => {
  if (path === "/" && pathname === "/") return true;
  if (path !== "/" && pathname.startsWith(path)) return true;
  return false;
};
---

<!DOCTYPE html>
<html lang="id" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} | Mahir SMS` : "Mahir School Management System"}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5C6096" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Google Font: Public Sans (matches mahirmatematika.com) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-emerald-100 selection:text-emerald-900">
    <!-- Top Decorative Brand Bar -->
    <div class="h-1 bg-gradient-to-r from-emerald-500 via-[#5C6096] to-[#B4CD4B] w-full"></div>

    <!-- Sticky Glass Navigation Header -->
    <header class="sticky top-0 z-50 glass-header">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <div class="flex items-center">
            <Logo size="md" showTagline={true} />
          </div>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
            <a
              href="/"
              class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 ${
                isNavActive("/")
                  ? "bg-emerald-50 text-emerald-700 shadow-xs"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              }`}
            >
              Beranda
            </a>
            <a
              href="/about"
              class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 ${
                isNavActive("/about")
                  ? "bg-emerald-50 text-emerald-700 shadow-xs"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              }`}
            >
              Tentang Kami
            </a>
            {user && (
              <a
                href="/dashboard"
                class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 ${
                  isNavActive("/dashboard")
                    ? "bg-emerald-50 text-emerald-700 shadow-xs"
                    : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
                }`}
              >
                Dashboard
              </a>
            )}
          </nav>

          <!-- Right Action Section (Auth Status) -->
          <div class="hidden md:flex items-center gap-3">
            {user ? (
              <div class="flex items-center gap-3">
                <a 
                  href="/dashboard" 
                  class="flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 transition-colors border border-slate-200"
                >
                  <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-emerald-500 to-[#5C6096] text-white flex items-center justify-center font-bold text-xs uppercase shadow-xs">
                    {(user.displayName || user.email || "U")[0]}
                  </div>
                  <span class="text-xs font-semibold text-slate-700 max-w-[120px] truncate">
                    {user.displayName || user.email?.split("@")[0]}
                  </span>
                </a>
                <form action="/api/auth/signout" method="get">
                  <button
                    type="submit"
                    class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition-colors"
                  >
                    Keluar
                  </button>
                </form>
              </div>
            ) : (
              <div class="flex items-center gap-2.5">
                <a
                  href="/signin"
                  class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-50 transition-colors"
                >
                  Masuk
                </a>
                <a
                  href="/register"
                  class="btn-primary text-xs !py-2 !px-4"
                >
                  Daftar Akun
                </a>
              </div>
            )}
          </div>

          <!-- Mobile Hamburger Button -->
          <div class="flex md:hidden items-center">
            <button
              id="mobile-menu-btn"
              type="button"
              class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
              aria-label="Toggle Navigation"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu Drawer (Hidden by default) -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 py-3 space-y-1">
          <a
            href="/"
            class="block px-3 py-2 rounded-md text-base font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700"
          >
            Beranda
          </a>
          <a
            href="/about"
            class="block px-3 py-2 rounded-md text-base font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700"
          >
            Tentang Kami
          </a>
          {user ? (
            <>
              <a
                href="/dashboard"
                class="block px-3 py-2 rounded-md text-base font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700"
              >
                Dashboard
              </a>
              <div class="pt-2 border-t border-slate-200 flex items-center justify-between px-3">
                <span class="text-xs font-semibold text-slate-600">
                  {user.displayName || user.email}
                </span>
                <form action="/api/auth/signout" method="get">
                  <button type="submit" class="text-xs font-semibold text-rose-600 hover:underline">
                    Keluar
                  </button>
                </form>
              </div>
            </>
          ) : (
            <div class="pt-2 border-t border-slate-200 flex flex-col gap-2 px-3">
              <a href="/signin" class="w-full text-center py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 rounded-lg">
                Masuk
              </a>
              <a href="/register" class="w-full text-center btn-primary text-xs !py-2">
                Daftar Akun
              </a>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Polished Educational Footer -->
    <footer class="bg-slate-900 text-slate-300 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
          <!-- Col 1: Brand Info -->
          <div class="md:col-span-1 space-y-4">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/20 p-1 flex items-center justify-center border border-emerald-500/30">
                <img src="/assets/images/logo-ribbon.png" alt="Mahir Logo" class="w-6 h-6 object-contain" />
              </div>
              <span class="text-lg font-bold text-white tracking-tight">Mahir SMS</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-400">
              Sistem Manajemen Sekolah & Pembelajaran Berkelanjutan berbasis metode multisensori terpadu dari ekosistem Mahir Matematika.
            </p>
            <div class="flex items-center gap-2 text-[11px] text-emerald-400 font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Sistem Aktif & Terintegrasi
            </div>
          </div>

          <!-- Col 2: Navigation Links -->
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Navigasi</h3>
            <ul class="space-y-2.5 text-xs text-slate-400">
              <li><a href="/" class="hover:text-emerald-400 transition-colors">Beranda</a></li>
              <li><a href="/about" class="hover:text-emerald-400 transition-colors">Tentang Kami</a></li>
              <li><a href="/signin" class="hover:text-emerald-400 transition-colors">Portal Masuk</a></li>
              <li><a href="/register" class="hover:text-emerald-400 transition-colors">Registrasi Guru & Sekolah</a></li>
            </ul>
          </div>

          <!-- Col 3: Educational Methodology -->
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Metode Mahir</h3>
            <ul class="space-y-2 text-xs text-slate-400">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
                Lihat & Dengar (Multisensori)
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#5C6096]"></span>
                Lakukan & Konseptual
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#B4CD4B]"></span>
                Catat & Repetisi Bermakna
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0EA5E9]"></span>
                Assesment Berkelanjutan
              </li>
            </ul>
          </div>

          <!-- Col 4: Platform Contact & Info -->
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Ekosistem Belajar</h3>
            <p class="text-xs text-slate-400 mb-3 leading-relaxed">
              Dikelola terpusat untuk menunjang kebutuhan guru, siswa, dan orang tua dalam memantau perkembangan belajar.
            </p>
            <div class="p-3 rounded-lg bg-slate-800/80 border border-slate-700/60 text-xs">
              <span class="block text-slate-400 text-[10px] uppercase font-bold tracking-wider">Pusat Informasi</span>
              <a 
                href="https://www.mahirmatematika.com" 
                target="_blank" 
                rel="noreferrer"
                class="font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
              >
                www.mahirmatematika.com &rarr;
              </a>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
          <p>Mahir School Management System &copy; 2026. Hak Cipta Dilindungi.</p>
          <div class="flex items-center gap-4 mt-3 sm:mt-0 text-[11px]">
            <span class="text-slate-400">Terinspirasi dari desain Minimal-UI Kit & Mahir Edu</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      const menuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener("click", () => {
          mobileMenu.classList.toggle("hidden");
        });
      }
    </script>
  </body>
</html>
