---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { getAllBranches } from "../firebase/firestore";
import BaseLayout from "../layouts/baselayout.astro";
import "../styles/global.css";

/* Check if the user is already authenticated */
const auth = getAuth(app);
if (Astro.cookies.has("__session")) {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  try {
    const decodedCookie = await auth.verifySessionCookie(sessionCookie);
    if (decodedCookie) {
      return Astro.redirect("/dashboard");
    }
  } catch (e) {
    // Session expired, allow registration
  }
}

// Fetch active branches for the dropdown
let branches = [];
try {
  branches = await getAllBranches();
} catch (e) {
  // Fallback branch if database empty or offline
  branches = [
    { id: "pemancar-bintaro-01", name: "Sekolah Pemancar Mahir Bintaro (Tangerang Selatan)" }
  ];
}
---

<BaseLayout title="Daftar Akun Baru" description="Pendaftaran akun Pendidik dan Orang Tua di Mahir School Management System">
  <div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8 bg-education-pattern">
    <div class="max-w-xl w-full">
      <!-- Card Container -->
      <div class="glass-card rounded-2xl p-6 sm:p-10 shadow-xl border border-slate-200/90 relative overflow-hidden">
        <!-- Top decorative color accent -->
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-linear-to-r from-[#5C6096] via-emerald-500 to-[#B4CD4B]"></div>

        <!-- Logo & Header -->
        <div class="text-center mb-6">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-100 mb-3 shadow-xs">
            <img src="/assets/images/logo-ribbon.png" alt="Mahir SMS" class="w-10 h-10 object-contain" />
          </div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
            Pendaftaran Akun
          </h1>
          <p class="text-xs text-slate-500 mt-1">
            Bergabunglah dengan ekosistem manajemen sekolah & pembelajaran multisensori Mahir
          </p>
        </div>

        <!-- Role Selector Tabs -->
        <div class="mb-6 p-1.5 rounded-xl bg-slate-100 border border-slate-200 grid grid-cols-2 gap-1.5">
          <button 
            type="button" 
            id="tab-teacher" 
            class="py-2.5 px-3 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer bg-white text-emerald-800 shadow-xs border border-slate-200"
          >
            <span>👨‍🏫</span>
            <span>Pendidik / Guru</span>
          </button>
          <button 
            type="button" 
            id="tab-parent" 
            class="py-2.5 px-3 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer text-slate-600 hover:text-slate-900"
          >
            <span>👨‍👩‍👦</span>
            <span>Orang Tua / Wali</span>
          </button>
        </div>

        <!-- Role Information Banner -->
        <div id="role-info-teacher" class="mb-5 p-3 rounded-xl bg-emerald-50/80 border border-emerald-200/80 text-emerald-900 text-xs">
          <div class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold">ℹ️</span>
            <div>
              <span class="font-bold">Verifikasi Pendidik:</span> Pendaftaran akun guru memerlukan peninjauan oleh Central Admin untuk memastikan kesesuaian unit Sekolah Pemancar.
            </div>
          </div>
        </div>

        <div id="role-info-parent" class="hidden mb-5 p-3 rounded-xl bg-sky-50/80 border border-sky-200/80 text-sky-900 text-xs">
          <div class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">⭐</span>
            <div>
              <span class="font-bold">Akses Terbuka untuk Orang Tua:</span> Akun langsung aktif! Dapatkan informasi kegiatan, workshop multisensori, serta konsultasi tumbuh kembang belajar matematika ananda.
            </div>
          </div>
        </div>

        <!-- Dynamic Error Banner (controlled by JS) -->
        <div id="register-error" class="hidden mb-5 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <span id="register-error-msg">Terjadi kesalahan.</span>
        </div>

        <!-- Registration Form -->
        <form action="/api/auth/register" method="post" class="space-y-4" id="register-form">
          <!-- Hidden inputs for role, bot honeypot & challenge -->
          <input type="hidden" name="role" id="selected-role" value="teacher" />
          <input type="text" name="b_website" id="b_website" class="hidden" tabindex="-1" autocomplete="off" />

          <!-- Shared: Full Name -->
          <div>
            <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Nama Lengkap <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <input
                type="text"
                name="name"
                id="name"
                required
                placeholder="cth. Sarah Wijaya, S.Pd."
                class="form-input !pl-9"
              />
            </div>
          </div>

          <!-- Shared: Email -->
          <div>
            <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Alamat Email <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
              </div>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="nama@email.com"
                class="form-input !pl-9"
              />
            </div>
          </div>

          <!-- Shared: Phone / WhatsApp (Especially crucial for Parents) -->
          <div>
            <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Nomor WhatsApp / Kontak <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <input
                type="tel"
                name="phone"
                id="phone"
                required
                placeholder="0812-xxxx-xxxx"
                class="form-input !pl-9"
              />
            </div>
          </div>

          <!-- Shared: Password -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                Kata Sandi <span class="text-rose-500">*</span>
              </label>
              <span class="text-[11px] text-slate-400 font-normal">Minimal 6 karakter</span>
            </div>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input
                type="password"
                name="password"
                id="password"
                required
                placeholder="••••••••"
                class="form-input !pl-9"
              />
            </div>
          </div>

          <!-- Branch Selection -->
          <div>
            <label for="branch-id" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              <span id="branch-label-text">Unit Sekolah Pemancar</span> <span class="text-rose-500">*</span>
            </label>
            <select name="branchId" id="branch-id" required class="form-input">
              <option value="">-- Pilih Cabang Sekolah --</option>
              {branches.map(b => (
                <option value={b.id}>{b.name}</option>
              ))}
            </select>
            <p id="branch-help-text" class="text-[11px] text-slate-400 mt-1">
              Pilih sekolah tempat Anda bertugas sebagai pendidik.
            </p>
          </div>

          <!-- Teacher Specific Fields -->
          <div id="teacher-fields" class="space-y-4 pt-1">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="nip" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  NIP / No. Pegawai <span class="text-slate-400 font-normal">(Opsional)</span>
                </label>
                <input
                  type="text"
                  name="nip"
                  id="nip"
                  placeholder="cth. 1985xxxx..."
                  class="form-input"
                />
              </div>
              <div>
                <label for="specialization" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Spesialisasi Ajar
                </label>
                <input
                  type="text"
                  name="specialization"
                  id="specialization"
                  placeholder="Matematika SD, dsb."
                  class="form-input"
                />
              </div>
            </div>
          </div>

          <!-- Parent Specific Fields -->
          <div id="parent-fields" class="hidden space-y-4 pt-1">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-800">Hubungkan Siswa Terdaftar</span>
                <span class="text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Opsional</span>
              </div>
              <p class="text-[11px] text-slate-500 mb-3 leading-relaxed">
                Jika anak Anda sudah terdaftar sebagai siswa di Mahir, isi kolom di bawah ini untuk menghubungkan rapor & presensi secara otomatis. Anda juga dapat menghubungkannya nanti.
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="child-name" class="block text-[11px] font-bold text-slate-600 uppercase mb-1">
                    Nama Siswa
                  </label>
                  <input
                    type="text"
                    name="childName"
                    id="child-name"
                    placeholder="Nama ananda"
                    class="form-input text-xs"
                  />
                </div>
                <div>
                  <label for="child-nis" class="block text-[11px] font-bold text-slate-600 uppercase mb-1">
                    NIS / No. Induk
                  </label>
                  <input
                    type="text"
                    name="childNis"
                    id="child-nis"
                    placeholder="Nomor induk siswa"
                    class="form-input text-xs"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Anti-Bot Security Badge -->
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-between text-xs text-slate-500">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-medium text-slate-600">Perlindungan Anti-Bot Aktif</span>
            </div>
            <span class="text-[11px] text-slate-400 font-mono">Mahir Shield v2</span>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="reg-btn"
              class="btn-primary w-full !py-3 text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="reg-text">Daftar Akun Baru</span>
              <svg id="reg-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>

        <!-- Footer link to sign in -->
        <div class="mt-6 pt-5 border-t border-slate-100 text-center">
          <p class="text-xs text-slate-500">
            Sudah memiliki akun?
            <a href="/signin" class="font-bold text-emerald-600 hover:text-emerald-700 hover:underline ml-1">
              Masuk di sini &rarr;
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const tabTeacher = document.querySelector("#tab-teacher") as HTMLButtonElement | null;
  const tabParent = document.querySelector("#tab-parent") as HTMLButtonElement | null;
  const selectedRoleInput = document.querySelector("#selected-role") as HTMLInputElement | null;
  const teacherFields = document.querySelector("#teacher-fields") as HTMLElement | null;
  const parentFields = document.querySelector("#parent-fields") as HTMLElement | null;
  const roleInfoTeacher = document.querySelector("#role-info-teacher") as HTMLElement | null;
  const roleInfoParent = document.querySelector("#role-info-parent") as HTMLElement | null;
  const branchLabel = document.querySelector("#branch-label-text") as HTMLElement | null;
  const branchHelp = document.querySelector("#branch-help-text") as HTMLElement | null;
  const regBtnText = document.querySelector("#reg-text") as HTMLElement | null;

  const regForm = document.querySelector("#register-form") as HTMLFormElement | null;
  const regBtn = document.querySelector("#reg-btn") as HTMLButtonElement | null;
  const regSpinner = document.querySelector("#reg-spinner") as HTMLElement | null;
  const regError = document.querySelector("#register-error") as HTMLElement | null;
  const regErrorMsg = document.querySelector("#register-error-msg") as HTMLElement | null;

  function setRole(role: "teacher" | "parent") {
    if (!selectedRoleInput) return;
    selectedRoleInput.value = role;

    if (role === "teacher") {
      tabTeacher?.classList.add("bg-white", "text-emerald-800", "shadow-xs", "border", "border-slate-200");
      tabTeacher?.classList.remove("text-slate-600");
      tabParent?.classList.remove("bg-white", "text-emerald-800", "shadow-xs", "border", "border-slate-200");
      tabParent?.classList.add("text-slate-600");

      teacherFields?.classList.remove("hidden");
      parentFields?.classList.add("hidden");
      roleInfoTeacher?.classList.remove("hidden");
      roleInfoParent?.classList.add("hidden");

      if (branchLabel) branchLabel.textContent = "Unit Sekolah Pemancar";
      if (branchHelp) branchHelp.textContent = "Pilih sekolah tempat Anda bertugas sebagai pendidik.";
      if (regBtnText) regBtnText.textContent = "Daftar Akun Pendidik";
    } else {
      tabParent?.classList.add("bg-white", "text-emerald-800", "shadow-xs", "border", "border-slate-200");
      tabParent?.classList.remove("text-slate-600");
      tabTeacher?.classList.remove("bg-white", "text-emerald-800", "shadow-xs", "border", "border-slate-200");
      tabTeacher?.classList.add("text-slate-600");

      parentFields?.classList.remove("hidden");
      teacherFields?.classList.add("hidden");
      roleInfoParent?.classList.remove("hidden");
      roleInfoTeacher?.classList.add("hidden");

      if (branchLabel) branchLabel.textContent = "Cabang Terdekat / Pilihan";
      if (branchHelp) branchHelp.textContent = "Pilih cabang terdekat untuk info kegiatan atau sekolah ananda.";
      if (regBtnText) regBtnText.textContent = "Daftar Akun Orang Tua";
    }
  }

  tabTeacher?.addEventListener("click", () => setRole("teacher"));
  tabParent?.addEventListener("click", () => setRole("parent"));

  function showRegisterError(message: string) {
    if (regError && regErrorMsg) {
      regErrorMsg.textContent = message;
      regError.classList.remove("hidden");
      regError.classList.add("flex");
    }
  }

  function hideRegisterError() {
    if (regError) {
      regError.classList.add("hidden");
      regError.classList.remove("flex");
    }
  }

  if (regForm) {
    regForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideRegisterError();

      const formData = new FormData(regForm);
      const name = formData.get("name")?.toString()?.trim();
      const email = formData.get("email")?.toString()?.trim();
      const password = formData.get("password")?.toString();
      const phone = formData.get("phone")?.toString()?.trim();
      const role = formData.get("role")?.toString() || "teacher";
      const branchId = formData.get("branchId")?.toString();
      const nip = formData.get("nip")?.toString()?.trim();
      const specialization = formData.get("specialization")?.toString()?.trim();
      const childName = formData.get("childName")?.toString()?.trim();
      const childNis = formData.get("childNis")?.toString()?.trim();
      const b_website = formData.get("b_website")?.toString();

      if (!name || !email || !password || !phone) {
        showRegisterError("Semua bidang bertanda bintang (*) wajib diisi.");
        return;
      }

      if (password.length < 6) {
        showRegisterError("Kata sandi minimal 6 karakter.");
        return;
      }

      // Show loading state
      if (regBtn) regBtn.disabled = true;
      if (regBtnText) regBtnText.textContent = "Memproses Pendaftaran...";
      if (regSpinner) regSpinner.classList.remove("hidden");

      try {
        const response = await fetch("/api/auth/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
          },
          body: JSON.stringify({ 
            name, 
            email, 
            password,
            phone,
            role,
            branchId,
            nip,
            specialization,
            childName,
            childNis,
            b_website
          }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.error || "Gagal membuat akun. Silakan coba kembali.");
        }

        // Redirect based on response instructions
        if (data.redirect) {
          window.location.assign(data.redirect);
        } else if (role === "teacher") {
          window.location.assign("/pending-approval");
        } else {
          window.location.assign("/signin?registered=success");
        }
      } catch (err: any) {
        console.error("Registration error:", err);
        if (regBtn) regBtn.disabled = false;
        if (regBtnText) regBtnText.textContent = role === "teacher" ? "Daftar Akun Pendidik" : "Daftar Akun Orang Tua";
        if (regSpinner) regSpinner.classList.add("hidden");

        showRegisterError(err.message || "Gagal membuat akun.");
      }
    });
  }
</script>
