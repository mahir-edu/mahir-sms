---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import BaseLayout from "../layouts/baselayout.astro";
import "../styles/global.css";

/* Check if the user is already authenticated */
const auth = getAuth(app);
if (Astro.cookies.has("__session")) {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  try {
    const decodedCookie = await auth.verifySessionCookie(sessionCookie);
    if (decodedCookie) {
      return Astro.redirect("/dashboard");
    }
  } catch (e) {
    // Session expired, allow registration
  }
}
---

<BaseLayout title="Daftar Akun Baru" description="Buat akun pendidik atau administrator di Mahir School Management System">
  <div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-education-pattern">
    <div class="max-w-md w-full">
      <!-- Card Container -->
      <div class="glass-card rounded-2xl p-8 sm:p-10 shadow-xl border border-slate-200/90 relative overflow-hidden">
        <!-- Top decorative color accent -->
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-linear-to-r from-[#5C6096] via-emerald-500 to-[#B4CD4B]"></div>

        <!-- Logo & Header -->
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-100 mb-4 shadow-xs">
            <img src="/assets/images/logo-ribbon.png" alt="Mahir SMS" class="w-10 h-10 object-contain" />
          </div>
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
            Registrasi Akun
          </h1>
          <p class="text-xs text-slate-500 mt-1.5">
            Mulai kelola kelas dan kurikulum multisensori Mahir
          </p>
        </div>

        <!-- Dynamic Error Banner (controlled by JS) -->
        <div id="register-error" class="hidden mb-5 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium flex items-center gap-2">
          <svg class="w-4 h-4 flex-shrink-0 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <span id="register-error-msg">Terjadi kesalahan.</span>
        </div>

        <!-- Registration Form -->
        <form action="/api/auth/register" method="post" class="space-y-4" id="register-form">
          <div>
            <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Nama Lengkap
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <input 
                type="text" 
                name="name" 
                id="name" 
                required 
                placeholder="Contoh: Budi Santoso, S.Pd."
                class="form-input !pl-9"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Alamat Email
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
              </div>
              <input 
                type="email" 
                name="email" 
                id="email" 
                required 
                placeholder="nama@sekolah.sch.id"
                class="form-input !pl-9"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
              Kata Sandi
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input 
                type="password" 
                name="password" 
                id="password" 
                required 
                minlength="6"
                placeholder="Minimal 6 karakter"
                class="form-input !pl-9"
              />
            </div>
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              id="reg-btn"
              class="btn-primary w-full !py-2.5 text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="reg-text">Daftar Akun Baru</span>
              <svg id="reg-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>

        <!-- Footer link to signin -->
        <div class="mt-6 pt-5 border-t border-slate-100 text-center">
          <p class="text-xs text-slate-500">
            Sudah memiliki akun?
            <a href="/signin" class="font-bold text-emerald-600 hover:text-emerald-700 hover:underline ml-1">
              Masuk di sini &rarr;
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const regForm = document.querySelector("#register-form") as HTMLFormElement | null;
  const regBtn = document.querySelector("#reg-btn") as HTMLButtonElement | null;
  const regText = document.querySelector("#reg-text") as HTMLElement | null;
  const regSpinner = document.querySelector("#reg-spinner") as HTMLElement | null;
  const regError = document.querySelector("#register-error") as HTMLElement | null;
  const regErrorMsg = document.querySelector("#register-error-msg") as HTMLElement | null;

  if (regForm) {
    regForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (regError) regError.classList.add("hidden");

      const formData = new FormData(regForm);
      const name = formData.get("name")?.toString()?.trim();
      const email = formData.get("email")?.toString()?.trim();
      const password = formData.get("password")?.toString();

      if (!name || !email || !password) {
        if (regError && regErrorMsg) {
          regErrorMsg.textContent = "Semua bidang wajib diisi.";
          regError.classList.remove("hidden");
        }
        return;
      }

      if (password.length < 6) {
        if (regError && regErrorMsg) {
          regErrorMsg.textContent = "Kata sandi minimal 6 karakter.";
          regError.classList.remove("hidden");
        }
        return;
      }

      // Show loading state
      if (regBtn) regBtn.disabled = true;
      if (regText) regText.textContent = "Mendaftarkan...";
      if (regSpinner) regSpinner.classList.remove("hidden");

      try {
        const response = await fetch("/api/auth/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
          },
          body: JSON.stringify({ name, email, password }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.error || "Gagal membuat akun. Silakan coba kembali.");
        }

        // Redirect to signin with success message
        window.location.assign("/signin?registered=success");
      } catch (err: any) {
        console.error("Registration error:", err);
        if (regBtn) regBtn.disabled = false;
        if (regText) regText.textContent = "Daftar Akun Baru";
        if (regSpinner) regSpinner.classList.add("hidden");

        if (regError && regErrorMsg) {
          regErrorMsg.textContent = err.message || "Gagal membuat akun.";
          regError.classList.remove("hidden");
        }
      }
    });
  }
</script>
