---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { 
  getUserProfile, 
  getUpcomingCalendarEvents, 
  getLinkedStudentsForParent 
} from "../firebase/firestore";
import type { StudentDocument, CalendarEventDocument } from "../types/database";
import BaseLayout from "../layouts/baselayout.astro";
import "../styles/global.css";

const auth = getAuth(app);

/* 1. Check current session */
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

/* 2. Check Firestore User Profile & Status */
const userProfile = await getUserProfile(user.uid);
if (userProfile && userProfile.status === "pending_approval") {
  return Astro.redirect("/pending-approval");
}

const userRole = userProfile?.role || "teacher";
const isHQAdmin = userRole === "hq_admin";
const isParent = userRole === "parent";
const isTeacher = userRole === "teacher" || userRole === "branch_admin";
const userName = userProfile?.displayName || user.displayName || user.email?.split("@")[0] || "Pengguna";

// Parent-specific variables
let linkedStudents: StudentDocument[] = [];
let parentEvents: CalendarEventDocument[] = [];
let isProspect = false;

if (isParent) {
  linkedStudents = await getLinkedStudentsForParent(user.uid);
  parentEvents = await getUpcomingCalendarEvents("parent", userProfile?.branchId || undefined);
  isProspect = userProfile?.parentMetadata?.isProspect ?? (linkedStudents.length === 0);
}

function formatEventDate(ts: any): string {
  if (!ts) return "";
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString("id-ID", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }) + " WIB";
}
---

<BaseLayout 
  title={isParent ? "Portal Orang Tua & Mitra Belajar | Mahir SMS" : "Dashboard Portal | Mahir SMS"} 
  description="Dashboard manajemen akademik dan komunitas pembelajaran Mahir SMS"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Welcome Header Banner -->
    <div class="rounded-2xl bg-linear-to-r from-slate-900 via-[#484B77] to-slate-900 p-6 sm:p-8 text-white shadow-xl relative overflow-hidden mb-8">
      <!-- Glow effect -->
      <div class="absolute -right-12 -top-12 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-3 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            {isHQAdmin && "Central HQ Administrator"}
            {isParent && (isProspect ? "Prospek & Mitra Belajar Mahir" : "Wali Siswa Mahir Terdaftar")}
            {isTeacher && "Portal Pendidik Aktif"}
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Selamat Datang, {userName}! {isParent ? "👨‍👩‍👦" : "👋"}
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl font-normal">
            {isParent ? (
              isProspect 
                ? "Selamat bergabung di ekosistem Mahir Edu. Dapatkan info kegiatan edukatif, konsultasi metode multisensori, atau hubungkan data siswa bila ananda telah terdaftar."
                : "Pantau perkembangan akademik, presensi, serta kegiatan pembelajaran ananda di Sekolah Pemancar Mahir."
            ) : (
              "Kelola aktivitas akademik, kurikulum multisensori, dan pantau perkembangan siswa Anda dari satu tempat."
            )}
          </p>
        </div>

        <!-- Quick Profile & Sign Out action -->
        <div class="flex items-center gap-3">
          <form action="/api/auth/signout" method="get">
            <button 
              type="submit" 
              class="px-4 py-2 rounded-xl text-xs font-bold text-slate-300 bg-white/10 hover:bg-rose-600 hover:text-white border border-white/20 transition-all cursor-pointer"
            >
              Keluar Akun
            </button>
          </form>
        </div>
      </div>
    </div>

    {/* ========================================================================= */}
    {/* VIEW 1: PARENT DASHBOARD (For Customers & Prospective Parent Leads)      */}
    {/* ========================================================================= */}
    {isParent && (
