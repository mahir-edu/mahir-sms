                <div class="space-y-4">
                  {parentEvents.map(evt => (
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-300 transition-colors">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-purple-100 text-purple-800">
                          <span>📅</span>
                          {formatEventDate(evt.startDate)}
