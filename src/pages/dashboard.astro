---
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { getUserProfile } from "../firebase/firestore";
import BaseLayout from "../layouts/baselayout.astro";
import "../styles/global.css";

const auth = getAuth(app);

/* Check current session */
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch (e) {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

/* Check Firestore User Profile & Status */
const userProfile = await getUserProfile(user.uid);
if (userProfile && userProfile.status === "pending_approval") {
  return Astro.redirect("/pending-approval");
}

const isHQAdmin = userProfile?.role === "hq_admin";
const userName = userProfile?.displayName || user.displayName || user.email?.split("@")[0] || "Pendidik";
const userEmail = user.email || "";
const userRole = userProfile?.role || "teacher";
---

<BaseLayout title="Dashboard Portal" description="Dashboard manajemen akademik dan kurikulum Mahir SMS">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Welcome Header Banner -->
    <div class="rounded-2xl bg-linear-to-r from-slate-900 via-[#484B77] to-slate-900 p-6 sm:p-8 text-white shadow-xl relative overflow-hidden mb-8">
      <!-- Glow effect -->
      <div class="absolute -right-12 -top-12 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative z-10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-3 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Portal Pendidik Aktif
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Selamat Datang, {userName}! 👋
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl font-normal">
            Kelola aktivitas akademik, kurikulum multisensori, dan pantau perkembangan siswa Anda dari satu tempat.
          </p>
        </div>

        <!-- Quick Profile & Sign Out action -->
        <div class="flex items-center gap-3">
          <form action="/api/auth/signout" method="get">
            <button 
              type="submit" 
              class="px-4 py-2 rounded-xl text-xs font-bold text-slate-300 bg-white/10 hover:bg-rose-600 hover:text-white border border-white/20 transition-all cursor-pointer"
            >
              Keluar Akun
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- 4 KPI Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
      <!-- KPI 1 -->
      <div class="glass-card glass-card-hover p-5 rounded-2xl border-l-4 border-l-emerald-500">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Siswa Terdaftar</span>
          <span class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">👥</span>
        </div>
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight">128</div>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-semibold text-emerald-600">
          <span>↑ 100% aktif</span>
          <span class="text-slate-400 font-normal">• 4 Rombel</span>
        </div>
      </div>

      <!-- KPI 2 -->
      <div class="glass-card glass-card-hover p-5 rounded-2xl border-l-4 border-l-brand-indigo">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Modul Kurikulum</span>
          <span class="w-8 h-8 rounded-lg bg-brand-indigo/15 text-brand-indigo flex items-center justify-center font-bold text-sm">📚</span>
        </div>
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight">16 Modul</div>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-semibold text-brand-indigo">
          <span>Multisensori</span>
          <span class="text-slate-400 font-normal">• Level 1 - 4</span>
        </div>
      </div>

      <!-- KPI 3 -->
      <div class="glass-card glass-card-hover p-5 rounded-2xl border-l-4 border-l-sky-500">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Sesi Hari Ini</span>
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-sm">⏰</span>
        </div>
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight">3 Sesi</div>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-semibold text-sky-600">
          <span>08:30 - 14:00 WIB</span>
          <span class="text-slate-400 font-normal">• Ruang Utama</span>
        </div>
      </div>

      <!-- KPI 4 -->
      <div class="glass-card glass-card-hover p-5 rounded-2xl border-l-4 border-l-brand-lime">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Rata-rata Ketuntasan</span>
          <span class="w-8 h-8 rounded-lg bg-brand-lime/25 text-[#677b15] flex items-center justify-center font-bold text-sm">⭐</span>
        </div>
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight">92.4%</div>
        <div class="flex items-center gap-1.5 mt-2 text-xs font-semibold text-[#718617]">
          <span>Sangat Memuaskan</span>
          <span class="text-slate-400 font-normal">• Asesmen 2026</span>
        </div>
      </div>
    </div>

    <!-- 2 Column Layout: Operations & Shortcuts -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Main Content (Left: 8 cols) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Jadwal & Sesi Hari Ini -->
        <div class="glass-card rounded-2xl p-6 shadow-sm border border-slate-200">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
            <div>
              <h2 class="text-base font-bold text-slate-900">Agenda & Sesi Kelas Hari Ini</h2>
              <p class="text-xs text-slate-500">Pantau kehadiran dan modul pembelajaran multisensori</p>
            </div>
            <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 text-xs font-bold">
              3 Jadwal Terjadwal
            </span>
          </div>

          <div class="space-y-3">
            <!-- Sesi 1 -->
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-300 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-800 flex flex-col items-center justify-center font-bold text-xs leading-none">
                  <span>08:30</span>
                  <span class="text-[9px] text-emerald-600 font-normal mt-0.5">WIB</span>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-slate-900">Kelas Boom: Konsep Pecahan & Geometri Dasar</h4>
                  <p class="text-xs text-slate-500">Kelas 4A • 28 Siswa • Ruang Multimedia</p>
                </div>
              </div>
              <span class="px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
                Selesai
              </span>
            </div>

            <!-- Sesi 2 -->
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-300 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-800 flex flex-col items-center justify-center font-bold text-xs leading-none">
                  <span>10:30</span>
                  <span class="text-[9px] text-sky-600 font-normal mt-0.5">WIB</span>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-slate-900">Literasi Foniks & Mahir Membaca (AHA 2)</h4>
                  <p class="text-xs text-slate-500">Kelas 2B • 24 Siswa • Ruang Belajar 3</p>
                </div>
              </div>
              <span class="px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800">
                Berlangsung
              </span>
            </div>

            <!-- Sesi 3 -->
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-300 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-brand-indigo/15 text-brand-indigo flex flex-col items-center justify-center font-bold text-xs leading-none">
                  <span>13:00</span>
                  <span class="text-[9px] text-brand-indigo font-normal mt-0.5">WIB</span>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-slate-900">Asesmen Formatif Multisensori Bab 3</h4>
                  <p class="text-xs text-slate-500">Kelas 5C • 32 Siswa • Laboratorium Komputer</p>
                </div>
              </div>
              <span class="px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-slate-200 text-slate-700">
                Mendatang
              </span>
            </div>
          </div>
        </div>

        <!-- Progress Kurikulum 5 Pilar Mahir -->
        <div class="glass-card rounded-2xl p-6 shadow-sm border border-slate-200">
          <h2 class="text-base font-bold text-slate-900 mb-1">Penerapan 5 Pilar Multisensori Mahir</h2>
          <p class="text-xs text-slate-500 mb-4">Tingkat penerapan modul konseptual semester berjalan</p>

          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1.5">
                <span>1. LIHAT (Alat Peraga Visual & Ilustrasi)</span>
                <span class="text-emerald-600">95%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2">
                <div class="bg-emerald-500 h-2 rounded-full" style="width: 95%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1.5">
                <span>2. DENGAR (Penjelasan Konseptual & Foniks)</span>
                <span class="text-sky-600">90%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2">
                <div class="bg-sky-500 h-2 rounded-full" style="width: 90%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1.5">
                <span>3. LAKUKAN (Eksplorasi Multisensori / Praktek)</span>
                <span class="text-[#718617]">88%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2">
                <div class="bg-brand-lime h-2 rounded-full" style="width: 88%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-slate-700 mb-1.5">
                <span>4. CATAT & 5. REPETISI (Latihan Buku AHA & Mahir)</span>
                <span class="text-brand-indigo">92%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2">
                <div class="bg-brand-indigo h-2 rounded-full" style="width: 92%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar Actions & System Info (Right: 4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Quick Action Shortcuts -->
        <div class="glass-card rounded-2xl p-6 shadow-sm border border-slate-200">
          <h2 class="text-base font-bold text-slate-900 mb-3">Aksi Cepat</h2>
          <div class="grid grid-cols-1 gap-2.5">
            {isHQAdmin && (
              <a 
                href="/dashboard/admin/users" 
                class="w-full flex items-center gap-3 p-3 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 transition-all text-xs font-bold"
              >
                <span class="w-8 h-8 rounded-lg bg-amber-200 text-amber-900 flex items-center justify-center text-sm">👥</span>
                <div class="flex flex-col text-left">
                  <span>Kelola Pengguna & Verifikasi</span>
                  <span class="text-[10px] text-amber-700 font-normal">Tinjau guru baru & orang tua</span>
                </div>
              </a>
            )}
            <button class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 border border-slate-200 hover:border-emerald-300 transition-all text-xs font-bold cursor-pointer">
              <span class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm">📝</span>
              <span>Input Nilai & Asesmen</span>
            </button>
            <button class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-brand-indigo/10 text-slate-700 hover:text-brand-indigo border border-slate-200 hover:border-brand-indigo/30 transition-all text-xs font-bold cursor-pointer">
              <span class="w-8 h-8 rounded-lg bg-brand-indigo/15 text-brand-indigo flex items-center justify-center text-sm">📚</span>
              <span>Pustaka Modul Belajar</span>
            </button>
            <button class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-sky-50 text-slate-700 hover:text-sky-800 border border-slate-200 hover:border-sky-300 transition-all text-xs font-bold cursor-pointer">
              <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center text-sm">👥</span>
              <span>Data Rombel & Presensi</span>
            </button>
            <button class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-brand-lime/20 text-slate-700 hover:text-[#677b15] border border-slate-200 hover:border-brand-lime/40 transition-all text-xs font-bold cursor-pointer">
              <span class="w-8 h-8 rounded-lg bg-brand-lime/20 text-[#677b15] flex items-center justify-center text-sm">📊</span>
              <span>Unduh Rapor Akademik</span>
            </button>
          </div>
        </div>

        <!-- Ecosystem Notice Box -->
        <div class="rounded-2xl p-6 bg-linear-to-br from-emerald-500/10 via-slate-50 to-[#5C6096]/10 border border-emerald-500/20">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Pemberitahuan Ekosistem</span>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Kurikulum Mahir Matematika 2026</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Modul Kelas Boom dan materi pembelajaran multisensori telah disinkronkan dengan database pusat Mahir Matematika.
          </p>
          <a 
            href="https://www.mahirmatematika.com" 
            target="_blank" 
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-800 hover:underline"
          >
            <span>Kunjungi Mahir Matematika</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
