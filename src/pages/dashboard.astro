<script>
  // Client-side script for linking student from Parent portal
  const linkForm = document.getElementById("link-student-form") as HTMLFormElement | null;
  const linkBtn = document.getElementById("btn-link-student") as HTMLButtonElement | null;
  const linkText = document.getElementById("btn-link-text");
  const linkSpinner = document.getElementById("link-spinner");
  const alertSuccess = document.getElementById("link-alert-success");
  const alertError = document.getElementById("link-alert-error");

  function hideAlerts() {
    if (alertSuccess) {
      alertSuccess.classList.add("hidden");
      alertSuccess.textContent = "";
    }
    if (alertError) {
      alertError.classList.add("hidden");
      alertError.textContent = "";
    }
  }

  if (linkForm) {
    linkForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideAlerts();

      const formData = new FormData(linkForm);
      const studentNis = formData.get("studentNis")?.toString()?.trim();

      if (!studentNis) {
        if (alertError) {
          alertError.textContent = "Silakan masukkan Nomor Induk Siswa (NIS).";
          alertError.classList.remove("hidden");
        }
        return;
      }

      if (linkBtn) linkBtn.disabled = true;
      if (linkText) linkText.textContent = "Menghubungkan...";
      if (linkSpinner) linkSpinner.classList.remove("hidden");

      try {
        const res = await fetch("/api/parent/link-student", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
          },
          body: JSON.stringify({ studentNis }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data.error || "Gagal menghubungkan data siswa.");
        }

        if (alertSuccess) {
          alertSuccess.textContent = data.message || `Berhasil menghubungkan siswa: ${data.studentName}! Halaman akan disegarkan...`;
          alertSuccess.classList.remove("hidden");
        }

        setTimeout(() => {
          window.location.reload();
        }, 1200);

      } catch (err: any) {
        if (alertError) {
          alertError.textContent = err.message || "Terjadi kesalahan saat menghubungkan data siswa.";
          alertError.classList.remove("hidden");
        }
        if (linkBtn) linkBtn.disabled = false;
        if (linkText) linkText.textContent = "Hubungkan Siswa";
        if (linkSpinner) linkSpinner.classList.add("hidden");
      }
    });
  }
</script>
