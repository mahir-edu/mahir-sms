---
import { app } from "../../../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { getUserProfile, getAllBranches, getAllBranchLicenses } from "../../../firebase/firestore";
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import DashboardPageHeader from "../../../components/dashboard/DashboardPageHeader.astro";
import DataMetricCard from "../../../components/dashboard/DataMetricCard.astro";
import LicenseStatusBadge from "../../../components/dashboard/LicenseStatusBadge.astro";
import BranchCreateModal from "../../../components/dashboard/BranchCreateModal.astro";
import type { BranchDocument, BranchLicenseDocument } from "../../../types/database";

/* Verify user session & ensure HQ Admin role */
const auth = getAuth(app);
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

const userProfile = await getUserProfile(user.uid);
if (!userProfile || userProfile.role !== "hq_admin") {
  return Astro.redirect("/dashboard");
}

// Fetch all branches & licenses
const branches = await getAllBranches();
const licenses = await getAllBranchLicenses();

// Map branch licenses
const licenseMap = new Map<string, BranchLicenseDocument>();
licenses.forEach(lic => {
  if (!licenseMap.has(lic.branchId) || lic.isActive) {
    licenseMap.set(lic.branchId, lic);
  }
});

// Calculate metrics
const totalBranches = branches.length;
let activeCount = 0;
let dueCount = 0;
let expiredCount = 0;

const nowTime = Date.now();
branches.forEach(branch => {
  const lic = licenseMap.get(branch.id);
  if (!lic) return;

  if (lic.status === "active") {
    activeCount++;
    if (lic.dueDate) {
      const due = lic.dueDate.toDate ? lic.dueDate.toDate().getTime() : new Date(lic.dueDate).getTime();
      const days = (due - nowTime) / (1000 * 60 * 60 * 24);
      if (days <= 30) dueCount++;
    }
  } else if (lic.status === "expired" || lic.status === "in_grace_period") {
    expiredCount++;
  }
});

function formatDate(ts: any): string {
  if (!ts) return "-";
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString("id-ID", {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
}
---

<DashboardLayout 
  title="Sekolah Pemancar & Lisensi" 
  description="Manajemen unit sekolah pemancar dan siklus hidup lisensi kemitraan Mahir Edu"
  userProfile={userProfile}
>
  <DashboardPageHeader 
    title="Sekolah Pemancar & Lisensi"
    description="Kelola data unit sekolah cabang mitra, pantau jatuh tempo perpanjangan lisensi, dan batasan kuota akses."
    breadcrumbs={[
      { label: "Central HQ Admin" },
      { label: "Sekolah & Lisensi" }
    ]}
  >
    <div slot="actions">
      <button 
        type="button" 
        id="btn-open-create-branch" 
        class="btn-primary text-xs py-2.5! px-4! flex items-center gap-1.5 font-bold cursor-pointer"
      >
        <span>+ Tambah Unit Sekolah</span>
      </button>
    </div>
  </DashboardPageHeader>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <DataMetricCard 
      title="Total Unit Sekolah"
      value={totalBranches}
      subtext="Cabang terdaftar di ekosistem"
      icon="🏫"
      theme="indigo"
    />
    <DataMetricCard 
      title="Lisensi Aktif"
      value={activeCount}
      subtext="Beroperasi normal"
      icon="🟢"
      theme="emerald"
    />
    <DataMetricCard 
      title="Jatuh Tempo (H-30)"
      value={dueCount}
      subtext="Memerlukan tagihan perpanjangan"
      icon="🟡"
      theme="amber"
    />
    <DataMetricCard 
      title="Tenggang / Expired"
      value={expiredCount}
      subtext="Perlu tindak lanjut admin"
      icon="🔴"
      theme="rose"
    />
  </div>

  <!-- Branch Table Card -->
  <div class="glass-card rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Daftar Sekolah Pemancar & Status Lisensi</h2>
        <p class="text-xs text-slate-500">Menampilkan seluruh unit operasional dan parameter lisensi aktif.</p>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <input 
          type="text" 
          id="search-branch" 
          placeholder="Cari unit atau kode cabang..." 
          class="form-input text-xs py-2! sm:w-64"
        />
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="bg-slate-50 text-slate-500 border-b border-slate-200">
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Kode & Nama Unit</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Lokasi & Kontak</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Paket Lisensi</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Masa Berlaku & Jatuh Tempo</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Status</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px] text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white" id="branch-table-body">
          {branches.length === 0 ? (
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                <div class="text-3xl mb-2">🏫</div>
                <p class="font-bold text-slate-700">Belum Ada Sekolah Terdaftar</p>
                <p class="text-[11px] mt-1">Gunakan tombol "Tambah Unit Sekolah" untuk mendaftarkan cabang baru.</p>
              </td>
            </tr>
          ) : (
            branches.map((branch) => {
              const lic = licenseMap.get(branch.id);
              let daysRem: number | undefined;
              if (lic?.dueDate) {
                const due = lic.dueDate.toDate ? lic.dueDate.toDate().getTime() : new Date(lic.dueDate).getTime();
                daysRem = Math.max(0, Math.ceil((due - nowTime) / (1000 * 60 * 60 * 24)));
              }

              return (
                <tr class="branch-row hover:bg-slate-50/80 transition-colors" data-name={branch.name.toLowerCase()} data-code={branch.code.toLowerCase()}>
                  <td class="py-3.5 px-4 font-semibold text-slate-900">
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xs shrink-0">
                        🏫
                      </div>
                      <div>
                        <div class="font-bold text-slate-900">{branch.name}</div>
                        <div class="font-mono text-[11px] text-slate-500 font-normal">{branch.code}</div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600">
                    <div>{branch.address?.city || "-"}, {branch.address?.province || ""}</div>
                    <div class="text-[11px] text-slate-400 mt-0.5">Kepsek: {branch.contact?.headmasterName || "-"}</div>
                  </td>
                  <td class="py-3.5 px-4">
                    {lic ? (
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200">
                        {lic.packageType}
                      </span>
                    ) : (
                      <span class="text-slate-400 text-[11px]">Belum Berlisensi</span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-slate-600">
                    {lic ? (
                      <div>
                        <div class="text-[11px] font-semibold text-slate-800">
                          Jatuh Tempo: <span class={daysRem !== undefined && daysRem <= 14 ? "text-amber-700 font-bold" : ""}>{formatDate(lic.dueDate)}</span>
                        </div>
                        <div class="text-[10px] text-slate-400">
                          Terbit: {formatDate(lic.issueDate)} &bull; Exp: {formatDate(lic.expiryDate)}
                        </div>
                      </div>
                    ) : (
                      <span class="text-slate-400 text-[11px]">-</span>
                    )}
                  </td>
                  <td class="py-3.5 px-4">
                    <LicenseStatusBadge 
                      status={branch.licenseStatus || lic?.status || "trial"} 
                      daysRemaining={daysRem}
                    />
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <a 
                      href={`/dashboard/admin/branches/${branch.id}`} 
                      class="px-3 py-1 rounded-lg text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors inline-block no-underline"
                    >
                      Lihat Detail &rarr;
                    </a>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Create Branch Modal -->
  <BranchCreateModal />
</DashboardLayout>

<script>
  const searchInput = document.getElementById("search-branch") as HTMLInputElement | null;
  const rows = document.querySelectorAll<HTMLTableRowElement>(".branch-row");

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.toLowerCase().trim();
    rows.forEach(r => {
      const name = r.dataset.name || "";
      const code = r.dataset.code || "";
      if (!q || name.includes(q) || code.includes(q)) {
        r.style.display = "";
      } else {
        r.style.display = "none";
      }
    });
  });

  // Modal Controls
  const modal = document.getElementById("branch-create-modal");
  const btnOpen = document.getElementById("btn-open-create-branch");
  const btnClose = document.getElementById("btn-close-branch-modal");
  const btnCancel = document.getElementById("btn-cancel-branch");
  const backdrop = document.getElementById("branch-modal-backdrop");
  const form = document.getElementById("branch-create-form") as HTMLFormElement | null;
  const alertBox = document.getElementById("branch-create-alert");
  const btnSubmitText = document.getElementById("btn-submit-branch-text");

  function openModal() {
    modal?.classList.remove("hidden");
    if (alertBox) alertBox.classList.add("hidden");
    form?.reset();
  }

  function closeModal() {
    modal?.classList.add("hidden");
  }

  btnOpen?.addEventListener("click", openModal);
  btnClose?.addEventListener("click", closeModal);
  btnCancel?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", closeModal);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    const fd = new FormData(form);
    const payload = {
      name: fd.get("name")?.toString()?.trim(),
      code: fd.get("code")?.toString()?.trim()?.toUpperCase(),
      address: {
        street: fd.get("street")?.toString()?.trim() || "",
        city: fd.get("city")?.toString()?.trim() || "",
        province: "",
        postalCode: "",
      },
      contact: {
        headmasterName: fd.get("headmasterName")?.toString()?.trim() || "",
        email: fd.get("email")?.toString()?.trim() || "",
        phone: fd.get("phone")?.toString()?.trim() || "",
      },
      license: {
        packageType: fd.get("packageType")?.toString() || "standard",
        dueDate: fd.get("dueDate")?.toString(),
        expiryDate: fd.get("expiryDate")?.toString(),
        maxTeachers: Number(fd.get("maxTeachers")) || 15,
        maxStudents: Number(fd.get("maxStudents")) || 150,
      },
    };

    const submitBtn = document.getElementById("btn-submit-branch") as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (btnSubmitText) btnSubmitText.textContent = "Menerbitkan...";

    try {
      const res = await fetch("/api/admin/branches/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Gagal mendaftarkan unit cabang.");

      alert(data.message || "Sekolah pemancar dan lisensi berhasil diterbitkan!");
      closeModal();
      window.location.reload();
    } catch (err: any) {
      if (alertBox) {
        alertBox.textContent = err.message || "Terjadi kesalahan.";
        alertBox.className = "mb-4 p-3 rounded-xl text-xs font-semibold bg-rose-50 border border-rose-200 text-rose-800";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnSubmitText) btnSubmitText.textContent = "Terbitkan Unit & Lisensi";
    }
  });
</script>
