---
import { app } from "../../../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { getUserProfile, getAllLessonMaterials, getAllCurriculums } from "../../../firebase/firestore";
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import DashboardPageHeader from "../../../components/dashboard/DashboardPageHeader.astro";
import DataMetricCard from "../../../components/dashboard/DataMetricCard.astro";

/* Verify user session & ensure HQ Admin role */
const auth = getAuth(app);
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

const userProfile = await getUserProfile(user.uid);
if (!userProfile || userProfile.role !== "hq_admin") {
  return Astro.redirect("/dashboard");
}

const materials = await getAllLessonMaterials();
const curriculums = await getAllCurriculums();
const currMap = new Map(curriculums.map(c => [c.id, c.title]));

const totalDownloads = materials.reduce((sum, m) => sum + (m.downloadCount || 0), 0);
const worksheetsCount = materials.filter(m => m.materialType === "worksheet").length;
const slidesCount = materials.filter(m => m.materialType === "slide_deck").length;
---

<DashboardLayout 
  title="Pustaka Materi Berlisensi" 
  description="Katalog aset digital pembelajaran multisensori dan aturan hak akses lisensi"
  userProfile={userProfile}
>
  <DashboardPageHeader 
    title="Pustaka Materi Ajar & Aset Digital"
    description="Kelola lembar kerja multisensori, slide modul, dan panduan manipulatif yang digate berdasarkan tier lisensi cabang."
    breadcrumbs={[
      { label: "Central HQ Admin" },
      { label: "Materi Berlisensi" }
    ]}
  >
    <div slot="actions">
      <button 
        type="button" 
        class="btn-primary text-xs py-2.5! px-4! flex items-center gap-1.5 font-bold cursor-pointer"
        onclick="alert('Upload materi ajar multisensori baru akan segera terhubung dengan Cloud Storage.')"
      >
        <span>+ Unggah Aset Materi</span>
      </button>
    </div>
  </DashboardPageHeader>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <DataMetricCard 
      title="Total Aset Digital"
      value={materials.length}
      subtext="Worksheet & modul"
      icon="📁"
      theme="indigo"
    />
    <DataMetricCard 
      title="Lembar Aktivitas"
      value={worksheetsCount}
      subtext="Format cetak & multisensori"
      icon="📝"
      theme="emerald"
    />
    <DataMetricCard 
      title="Slide Presentasi"
      value={slidesCount}
      subtext="Panduan mengajar visual"
      icon="🖥️"
      theme="sky"
    />
    <DataMetricCard 
      title="Total Diunduh"
      value={totalDownloads}
      subtext="Akses oleh Sekolah Pemancar"
      icon="📥"
      theme="amber"
    />
  </div>

  <!-- Materials Table -->
  <div class="glass-card rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Daftar Materi & Hak Akses Lisensi</h2>
        <p class="text-xs text-slate-500">Materi terkunci secara otomatis bila lisensi unit tidak mencukupi.</p>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="bg-slate-50 text-slate-500 border-b border-slate-200">
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Judul Materi</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Kurikulum</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Tipe & Format</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Tier Lisensi Minimal</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Diunduh</th>
            <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px] text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {materials.length === 0 ? (
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                <div class="text-3xl mb-2">📁</div>
                <p class="font-bold text-slate-700">Belum Ada Materi Terunggah</p>
                <p class="text-[11px] mt-1">Gunakan tombol "Unggah Aset Materi" untuk menambahkan modul pertama.</p>
              </td>
            </tr>
          ) : (
            materials.map((mat) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-slate-900">
                  <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-indigo-50 text-brand-indigo flex items-center justify-center font-bold text-sm shrink-0">
                      {mat.materialType === "slide_deck" ? "🖥️" : mat.materialType === "video_tutorial" ? "🎥" : "📄"}
                    </span>
                    <div>
                      <div class="font-bold text-slate-900">{mat.title}</div>
                      <div class="text-[11px] text-slate-500 font-normal">{mat.fileName || "dokumen.pdf"}</div>
                    </div>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-slate-600">
                  {currMap.get(mat.curriculumId) || mat.curriculumId}
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold uppercase bg-slate-100 text-slate-700">
                    {mat.materialType}
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-purple-100 text-purple-800 border border-purple-200">
                    Paket {mat.requiredPackageTier}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-700 font-semibold">
                  {mat.downloadCount || 0}x
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a 
                    href={mat.fileUrl || "#"} 
                    target="_blank"
                    class="px-2.5 py-1 rounded-lg text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors inline-block no-underline"
                  >
                    Pratinjau
                  </a>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>
