---
import { app } from "../../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { 
  getUserProfile, 
  getBranch, 
  getActiveBranchLicense, 
  getUpcomingCalendarEvents 
} from "../../firebase/firestore";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardPageHeader from "../../components/dashboard/DashboardPageHeader.astro";

/* Verify user session */
const auth = getAuth(app);
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

const userProfile = await getUserProfile(user.uid);
const activeBranch = userProfile?.branchId ? await getBranch(userProfile.branchId) : null;
const activeLicense = userProfile?.branchId ? await getActiveBranchLicense(userProfile.branchId) : null;

if (userProfile?.role === "hq_admin") {
  return Astro.redirect("/dashboard/admin/calendar");
}

const events = await getUpcomingCalendarEvents(userProfile?.role, userProfile?.branchId || undefined);

function formatEventDate(ts: any): string {
  if (!ts) return "-";
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString("id-ID", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }) + " WIB";
}
---

<DashboardLayout 
  title="Kalender & Agenda Kegiatan" 
  description="Jadwal akademik, pelatihan, dan webinar Mahir Edu"
  userProfile={userProfile}
  activeBranch={activeBranch}
  activeLicense={activeLicense}
>
  <DashboardPageHeader 
    title="Kalender & Agenda Kegiatan"
    description="Pantau kegiatan akademik, sesi webinar, dan pelatihan yang relevan dengan peran Anda."
    breadcrumbs={[
      { label: "Kalender Kegiatan" }
    ]}
  />

  <div class="space-y-4">
    {events.length === 0 ? (
      <div class="glass-card p-12 text-center text-slate-400 rounded-2xl border border-slate-200">
        <div class="text-4xl mb-2">📅</div>
        <p class="font-bold text-slate-700 text-sm">Belum Ada Agenda Terjadwal</p>
        <p class="text-xs mt-1">Jadwal kegiatan terbaru akan ditampilkan di sini.</p>
      </div>
    ) : (
      events.map((evt) => (
        <div class="glass-card glass-card-hover rounded-2xl p-5 border border-slate-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-700 border border-purple-200 flex flex-col items-center justify-center font-bold text-xs shrink-0">
              <span>📅</span>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-purple-100 text-purple-800">
                  {formatEventDate(evt.startDate)}
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800">
                  {evt.locationType === "online" ? "Daring (Google Meet)" : evt.locationType}
                </span>
              </div>
              <h3 class="text-sm font-bold text-slate-900">{evt.title}</h3>
              <p class="text-xs text-slate-500 mt-0.5 max-w-2xl">{evt.description}</p>
            </div>
          </div>

          <div class="shrink-0 flex items-center gap-2 w-full md:w-auto">
            {evt.onlineMeetingUrl && (
              <a 
                href={evt.onlineMeetingUrl} 
                target="_blank" 
                class="px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors inline-block text-center w-full md:w-auto no-underline"
              >
                Ikuti Sesi
              </a>
            )}
          </div>
        </div>
      ))
    )}
  </div>
</DashboardLayout>
