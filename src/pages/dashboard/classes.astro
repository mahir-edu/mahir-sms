---
import { app } from "../../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { 
  getUserProfile, 
  getBranch, 
  getActiveBranchLicense, 
  getClassesForBranch 
} from "../../firebase/firestore";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardPageHeader from "../../components/dashboard/DashboardPageHeader.astro";
import DataMetricCard from "../../components/dashboard/DataMetricCard.astro";

/* Verify user session */
const auth = getAuth(app);
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

const userProfile = await getUserProfile(user.uid);
const activeBranch = userProfile?.branchId ? await getBranch(userProfile.branchId) : null;
const activeLicense = userProfile?.branchId ? await getActiveBranchLicense(userProfile.branchId) : null;

// Fetch classes for branch (or all if HQ Admin)
const classes = await getClassesForBranch(userProfile?.role === "hq_admin" ? undefined : userProfile?.branchId || undefined);
const totalStudents = classes.reduce((sum, c) => sum + (c.studentCount || 0), 0);
---

<DashboardLayout 
  title="Rombongan Belajar & Kelas" 
  description="Manajemen rombel, wali kelas, dan daftar siswa"
  userProfile={userProfile}
  activeBranch={activeBranch}
  activeLicense={activeLicense}
>
  <DashboardPageHeader 
    title="Rombongan Belajar & Kelas Ajar"
    description="Kelola pembagian rombel, penugasan guru wali kelas, dan kuota siswa unit sekolah."
    breadcrumbs={[
      { label: "Kelas & Rombel" }
    ]}
  >
    <div slot="actions">
      {(userProfile?.role === "hq_admin" || userProfile?.role === "branch_admin") && (
        <button 
          type="button" 
          class="btn-primary text-xs py-2.5! px-4! flex items-center gap-1.5 font-bold cursor-pointer"
          onclick="alert('Formulir pembuatan rombel kelas baru akan segera aktif.')"
        >
          <span>+ Tambah Kelas Baru</span>
        </button>
      )}
    </div>
  </DashboardPageHeader>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <DataMetricCard 
      title="Total Rombel"
      value={classes.length}
      subtext="Kelas aktif semester ini"
      icon="🏛️"
      theme="indigo"
    />
    <DataMetricCard 
      title="Total Siswa"
      value={totalStudents}
      subtext="Tersebar di seluruh rombel"
      icon="👥"
      theme="emerald"
    />
    <DataMetricCard 
      title="Tingkat Kelas"
      value="Kelas 1 - 6"
      subtext="Fase Fondasi & Mahir"
      icon="📚"
      theme="sky"
    />
    <DataMetricCard 
      title="Kapasitas Lisensi"
      value={activeLicense ? `${totalStudents} / ${activeLicense.maxStudents}` : "100% Normal"}
      subtext="Batas kuota siswa"
      icon="⭐"
      theme="lime"
    />
  </div>

  <!-- Classes Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {classes.length === 0 ? (
      <div class="col-span-full glass-card p-12 text-center text-slate-400 rounded-2xl border border-slate-200">
        <div class="text-4xl mb-2">👥</div>
        <p class="font-bold text-slate-700 text-sm">Belum Ada Rombel Kelas</p>
        <p class="text-xs mt-1">Buat rombel kelas pertama Anda untuk mulai mengorganisir data siswa dan presensi.</p>
      </div>
    ) : (
      classes.map((cls) => (
        <div class="glass-card glass-card-hover rounded-2xl p-6 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200">
                Tingkat SD
              </span>
              <span class="text-xs font-semibold text-slate-500">
                {cls.studentCount || 0} Siswa
              </span>
            </div>

            <h3 class="text-base font-bold text-slate-900 mb-1">{cls.name}</h3>
            <p class="text-xs text-slate-500 mb-4">
              Wali Kelas: <strong class="text-slate-800">{cls.homeroomTeacherName || "Belum Ditentukan"}</strong>
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="inline-flex items-center gap-1 text-[11px] text-emerald-700 font-bold">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Aktif
            </span>
            <div class="flex items-center gap-2">
              <a 
                href="/dashboard/attendance" 
                class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-700 hover:text-emerald-700 hover:bg-slate-100 transition-colors no-underline"
              >
                Presensi
              </a>
              <a 
                href="/dashboard/assessments" 
                class="px-2.5 py-1 rounded-md text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors no-underline"
              >
                Asesmen
              </a>
            </div>
          </div>
        </div>
      ))
    )}
  </div>
</DashboardLayout>
