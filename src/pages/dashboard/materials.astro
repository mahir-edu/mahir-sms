---
import { app } from "../../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { 
  getUserProfile, 
  getBranch, 
  getActiveBranchLicense, 
  getLessonMaterialsForBranch 
} from "../../firebase/firestore";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardPageHeader from "../../components/dashboard/DashboardPageHeader.astro";

/* Verify user session */
const auth = getAuth(app);
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

const userProfile = await getUserProfile(user.uid);
const activeBranch = userProfile?.branchId ? await getBranch(userProfile.branchId) : null;
const activeLicense = userProfile?.branchId ? await getActiveBranchLicense(userProfile.branchId) : null;

// License check & materials retrieval
let materialsResult = {
  allowed: false,
  materials: [] as any[],
  reason: "Cabang Anda belum memiliki unit sekolah atau lisensi aktif.",
};

if (userProfile?.role === "hq_admin") {
  // HQ Admin has unrestricted access
  return Astro.redirect("/dashboard/admin/materials");
} else if (userProfile?.branchId) {
  materialsResult = await getLessonMaterialsForBranch(userProfile.branchId);
}

function formatBytes(bytes: number): string {
  if (!bytes || bytes === 0) return "-";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}
---

<DashboardLayout 
  title="Pustaka Bahan Ajar" 
  description="Koleksi modul multisensori dan lembar aktivitas berlisensi"
  userProfile={userProfile}
  activeBranch={activeBranch}
  activeLicense={activeLicense}
>
  <DashboardPageHeader 
    title="Pustaka Bahan Ajar & Modul Multisensori"
    description={`Akses materi pembelajaran resmi Mahir Edu sesuai paket lisensi ${activeLicense?.packageType ? `"${activeLicense.packageType.toUpperCase()}"` : "unit Anda"}.`}
    breadcrumbs={[
      { label: "Pustaka Materi" }
    ]}
  />

  {/* License Gate Warning if Not Allowed */}
  {!materialsResult.allowed ? (
    <div class="glass-card rounded-2xl p-8 text-center border-l-4 border-l-amber-500 bg-amber-50/30">
      <div class="text-4xl mb-3">🔒</div>
      <h3 class="text-base font-bold text-slate-900 mb-1">Akses Bahan Ajar Terkunci</h3>
      <p class="text-xs text-slate-600 max-w-lg mx-auto mb-4">
        {materialsResult.reason}
      </p>
      <a 
        href="/dashboard" 
        class="btn-outline text-xs py-2! px-4! inline-flex items-center gap-1.5"
      >
        <span>&larr; Kembali ke Dashboard</span>
      </a>
    </div>
  ) : (
    <div>
      <!-- Search & Category Filter Toolbar -->
      <div class="glass-card rounded-2xl p-4 mb-6 border border-slate-200 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">🔍</span>
          <input 
            type="text" 
            id="search-branch-mat" 
            placeholder="Cari modul materi, lembar kerja siswa, atau topik..." 
            class="form-input text-xs pl-9! py-2!" 
          />
        </div>

        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
          <button 
            type="button" 
            class="filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-purple-100 text-purple-900 border border-purple-200 transition-colors cursor-pointer"
            data-type=""
          >
            Semua ({materialsResult.materials.length})
          </button>
          <button 
            type="button" 
            class="filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer"
            data-type="worksheet"
          >
            📄 Lembar Kerja
          </button>
          <button 
            type="button" 
            class="filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer"
            data-type="slide_deck"
          >
            🖥️ Slide Modul
          </button>
          <button 
            type="button" 
            class="filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer"
            data-type="printable_manipulative"
          >
            ✂️ Alat Peraga Cetak
          </button>
        </div>
      </div>

      <!-- Materials Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {materialsResult.materials.length === 0 ? (
          <div class="col-span-full glass-card p-12 text-center text-slate-400 rounded-2xl border border-slate-200">
            <div class="text-4xl mb-2">📁</div>
            <p class="font-bold text-slate-700 text-sm">Belum Ada Materi untuk Kurikulum Unit Anda</p>
            <p class="text-xs mt-1">Central Admin sedang menyiapkan materi tambahan untuk semester ini.</p>
          </div>
        ) : (
          materialsResult.materials.map((mat) => (
            <div 
              class="mat-card glass-card glass-card-hover rounded-2xl p-5 border border-slate-200 flex flex-col justify-between transition-all"
              data-title={mat.title.toLowerCase()}
              data-desc={(mat.description || "").toLowerCase()}
              data-filename={(mat.fileName || "").toLowerCase()}
              data-type={mat.materialType}
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800">
                    {mat.materialType === "slide_deck" 
                      ? "🖥️ Slide Modul" 
                      : mat.materialType === "printable_manipulative" 
                      ? "✂️ Alat Peraga" 
                      : mat.materialType === "video_tutorial"
                      ? "🎥 Video Tutorial"
                      : "📄 Lembar Kerja"}
                  </span>
                  <span class="text-[10px] font-bold text-emerald-700 flex items-center gap-1">
                    <span>✓ Lisensi Terpenuhi</span>
                  </span>
                </div>

                <h4 class="text-sm font-bold text-slate-900 mb-1 leading-snug">{mat.title}</h4>
                <p class="text-xs text-slate-500 mb-4 line-clamp-3 leading-relaxed">
                  {mat.description || "Materi pembelajaran multisensori terpadu standar Mahir Edu."}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                <div class="text-[11px] text-slate-400">
                  <div class="font-semibold text-slate-600 truncate max-w-[140px]">{mat.fileName || "dokumen.pdf"}</div>
                  {mat.fileSizeBytes ? <div>{formatBytes(mat.fileSizeBytes)}</div> : null}
                </div>

                <a 
                  href={mat.fileUrl || "#"} 
                  target="_blank" 
                  class="btn-download-mat px-3 py-1.5 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors inline-flex items-center gap-1.5 no-underline cursor-pointer shadow-2xs"
                  data-id={mat.id}
                >
                  <span>Buka Berkas</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  )}
</DashboardLayout>

<script>
  const searchInput = document.getElementById("search-branch-mat") as HTMLInputElement | null;
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>(".filter-cat-btn");
  const cards = document.querySelectorAll<HTMLElement>(".mat-card");

  let currentCategory = "";

  function applyFilters() {
    const q = searchInput?.value.toLowerCase().trim() || "";

    cards.forEach(card => {
      const title = card.dataset.title || "";
      const desc = card.dataset.desc || "";
      const fname = card.dataset.filename || "";
      const type = card.dataset.type || "";

      const matchQ = !q || title.includes(q) || desc.includes(q) || fname.includes(q);
      const matchCat = !currentCategory || type === currentCategory;

      if (matchQ && matchCat) {
        card.style.display = "";
      } else {
        card.style.display = "none";
      }
    });
  }

  searchInput?.addEventListener("input", applyFilters);

  categoryButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      currentCategory = btn.dataset.type || "";

      categoryButtons.forEach(b => {
        if (b === btn) {
          b.className = "filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-purple-100 text-purple-900 border border-purple-200 transition-colors cursor-pointer";
        } else {
          b.className = "filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer";
        }
      });

      applyFilters();
    });
  });

  // Track download counts when user opens / downloads material
  document.querySelectorAll<HTMLAnchorElement>(".btn-download-mat").forEach(link => {
    link.addEventListener("click", () => {
      const matId = link.dataset.id;
      if (matId) {
        fetch("/api/materials/track-download", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: matId }),
        }).catch(err => console.error("Track download error:", err));
      }
    });
  });
</script>
