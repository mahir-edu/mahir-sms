---
import { app } from "../../firebase/server";
import { getAuth } from "firebase-admin/auth";
import { 
  getUserProfile, 
  getBranch, 
  getActiveBranchLicense, 
  getClassesForBranch,
  getLinkedStudentsForParent
} from "../../firebase/firestore";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DashboardPageHeader from "../../components/dashboard/DashboardPageHeader.astro";
import DataMetricCard from "../../components/dashboard/DataMetricCard.astro";

/* Verify user session */
const auth = getAuth(app);
if (!Astro.cookies.has("__session")) {
  return Astro.redirect("/signin");
}

let user;
try {
  const sessionCookie = Astro.cookies.get("__session")!.value;
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  user = await auth.getUser(decodedCookie.uid);
} catch {
  return Astro.redirect("/signin");
}

if (!user) {
  return Astro.redirect("/signin");
}

const userProfile = await getUserProfile(user.uid);
const activeBranch = userProfile?.branchId ? await getBranch(userProfile.branchId) : null;
const activeLicense = userProfile?.branchId ? await getActiveBranchLicense(userProfile.branchId) : null;
const isParent = userProfile?.role === "parent";

// If parent, fetch linked students
let linkedStudents: any[] = [];
if (isParent) {
  linkedStudents = await getLinkedStudentsForParent(user.uid);
}

// Fetch classes
const classes = await getClassesForBranch(userProfile?.branchId || undefined);
const todayStr = new Date().toISOString().split("T")[0];
---

<DashboardLayout 
  title="Presensi & Kehadiran Siswa" 
  description="Pencatatan kehadiran harian dan integrasi notifikasi orang tua"
  userProfile={userProfile}
  activeBranch={activeBranch}
  activeLicense={activeLicense}
>
  <DashboardPageHeader 
    title={isParent ? "Presensi & Kehadiran Ananda" : "Presensi & Kehadiran Kelas"}
    description={isParent 
      ? "Pantau catatan presensi dan kedisiplinan belajar ananda di sekolah." 
      : "Catat kehadiran harian siswa per sesi rombel dengan notifikasi email otomatis ke orang tua."}
    breadcrumbs={[
      { label: "Presensi Harian" }
    ]}
  />

  {isParent ? (
    <div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <DataMetricCard 
          title="Kehadiran Semester Ini"
          value="98.5%"
          subtext="Tingkat partisipasi tinggi"
          icon="⭐"
          theme="emerald"
        />
        <DataMetricCard 
          title="Total Hadir"
          value="48 Hari"
          subtext="Dari 49 hari aktif"
          icon="📅"
          theme="indigo"
        />
        <DataMetricCard 
          title="Izin / Sakit"
          value="1 Hari"
          subtext="Izin dengan surat keterangan"
          icon="📝"
          theme="sky"
        />
      </div>

      <div class="glass-card rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
        <div class="p-4 sm:p-5 border-b border-slate-100 bg-white">
          <h3 class="text-sm font-bold text-slate-900">Riwayat Kehadiran Siswa</h3>
          <p class="text-xs text-slate-500">Menampilkan rekaman presensi terbaru untuk siswa terhubung.</p>
        </div>

        {linkedStudents.length === 0 ? (
          <div class="p-10 text-center text-slate-400">
            <div class="text-3xl mb-2">👨‍👩‍👦</div>
            <p class="font-bold text-slate-700 text-sm">Belum Ada Siswa Terhubung</p>
            <p class="text-xs mt-1">Hubungkan Nomor Induk Siswa (NIS) di halaman utama dashboard Anda.</p>
          </div>
        ) : (
          <div class="divide-y divide-slate-100">
            {linkedStudents.map(student => (
              <div class="p-4 sm:p-5 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-sm">
                    🎓
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900">{student.fullName}</h4>
                    <p class="text-xs text-slate-500">NIS: {student.nis} &bull; Terakhir Tercatat: Hadir ({todayStr})</p>
                  </div>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                  ✓ Presensi Lengkap
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  ) : (
    <div>
      <!-- Controls Toolbar -->
      <div class="glass-card rounded-2xl p-4 sm:p-5 mb-6 border border-slate-200 shadow-xs">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Pilih Rombel / Kelas</label>
            <select id="class-select" class="form-input text-xs">
              {classes.length === 0 ? (
                <option value="">Belum ada rombel</option>
              ) : (
                classes.map(c => (
                  <option value={c.id}>{c.name} ({c.studentCount || 0} Siswa)</option>
                ))
              )}
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Tanggal Sesi</label>
            <input type="date" value={todayStr} class="form-input text-xs" />
          </div>

          <div class="flex items-end">
            <button 
              type="button" 
              class="btn-primary text-xs py-2.5! px-4! w-full font-bold cursor-pointer"
              onclick="alert('Presensi harian berhasil disimpan! Notifikasi otomatis telah disinkronkan ke antrean email.')"
            >
              Simpan Presensi Kelas
            </button>
          </div>
        </div>
      </div>

      <!-- Attendance Ledger Table -->
      <div class="glass-card rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
        <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-white">
          <div>
            <h3 class="text-sm font-bold text-slate-900">Daftar Kehadiran Siswa Hari Ini</h3>
            <p class="text-xs text-slate-500">Siswa yang tercatat Alpa tanpa keterangan akan otomatis menerima email peringatan ke wali.</p>
          </div>
          <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 text-xs font-bold">
            Tanggal: {todayStr}
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-slate-50 text-slate-500 border-b border-slate-200">
                <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">No. & Nama Siswa</th>
                <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">NIS</th>
                <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Status Kehadiran</th>
                <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px]">Catatan / Keterangan</th>
                <th class="py-3 px-4 font-bold uppercase tracking-wider text-[10px] text-right">Alert Wali</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-slate-900">1. Ahmad Rizky Pratama</td>
                <td class="py-3.5 px-4 font-mono text-slate-500">2026-MHR-001</td>
                <td class="py-3.5 px-4">
                  <div class="inline-flex rounded-lg border border-slate-200 p-0.5 bg-slate-50">
                    <button class="px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-500 text-white shadow-xs cursor-pointer">Hadir</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Sakit</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Izin</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-rose-700 cursor-pointer">Alpa</button>
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <input type="text" placeholder="Catatan singkat..." class="form-input text-xs py-1! w-48" />
                </td>
                <td class="py-3.5 px-4 text-right">
                  <span class="text-[11px] text-slate-400 font-semibold">Tersinkron</span>
                </td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-slate-900">2. Aisyah Putri Nurhaliza</td>
                <td class="py-3.5 px-4 font-mono text-slate-500">2026-MHR-002</td>
                <td class="py-3.5 px-4">
                  <div class="inline-flex rounded-lg border border-slate-200 p-0.5 bg-slate-50">
                    <button class="px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-500 text-white shadow-xs cursor-pointer">Hadir</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Sakit</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Izin</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-rose-700 cursor-pointer">Alpa</button>
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <input type="text" placeholder="Catatan singkat..." class="form-input text-xs py-1! w-48" />
                </td>
                <td class="py-3.5 px-4 text-right">
                  <span class="text-[11px] text-slate-400 font-semibold">Tersinkron</span>
                </td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-slate-900">3. Bima Satria Perkasa</td>
                <td class="py-3.5 px-4 font-mono text-slate-500">2026-MHR-003</td>
                <td class="py-3.5 px-4">
                  <div class="inline-flex rounded-lg border border-slate-200 p-0.5 bg-slate-50">
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Hadir</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Sakit</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer">Izin</button>
                    <button class="px-2.5 py-1 rounded-md text-xs font-bold bg-rose-500 text-white shadow-xs cursor-pointer">Alpa</button>
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <input type="text" value="Tanpa kabar dari wali" class="form-input text-xs py-1! w-48 border-rose-300 text-rose-800" />
                </td>
                <td class="py-3.5 px-4 text-right">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-300">
                    Email Siap Dikirim
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )}
</DashboardLayout>
